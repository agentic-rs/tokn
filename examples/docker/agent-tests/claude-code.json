{
  "schema_version": 1,
  "gateway_image": "tokn-gateway-cli:agent-test",
  "config_file": "~/.tokn/router/config.toml",
  "router_url": "http://127.0.0.1:4141",
  "timeout_secs": 180,
  "cases": [
    {
      "id": "claude-code-copilot-sonnet-text",
      "agent": "claude-code",
      "mode": "api",
      "model": "claude-sonnet-4.6",
      "base_path": "/opencode-github-copilot/v1",
      "api": "messages",
      "probe": "text"
    },
    {
      "id": "claude-code-copilot-sonnet-read",
      "agent": "claude-code",
      "mode": "api",
      "model": "claude-sonnet-4.6",
      "base_path": "/opencode-github-copilot/v1",
      "api": "messages",
      "probe": "read_tool"
    }
  ]
}
