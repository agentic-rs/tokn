FROM docker.io/node:22-alpine

RUN apk add --no-cache ca-certificates git ripgrep \
  && npm install --global --ignore-scripts @earendil-works/pi-coding-agent@0.85.1 \
  && test "$(pi --version)" = "0.85.1"

COPY scripts/docker/pi-trial-entrypoint.sh /usr/local/bin/pi-trial-entrypoint
RUN chmod 0755 /usr/local/bin/pi-trial-entrypoint

WORKDIR /workspace
ENTRYPOINT ["pi-trial-entrypoint"]
