FROM docker.io/node:22-alpine

# DSH rc2 uses caret ranges for its internal packages. Resolve those ranges
# against the rc2 publication window so a partial later release cannot mix in.
RUN apk add --no-cache ca-certificates git ripgrep \
  && apk add --no-cache --virtual .build-deps build-base linux-headers python3 \
  && npm install --global --before=2026-09-11T00:00:00Z @deepseek-ai/dsh@0.1.5-rc.2 \
  && npm rebuild --prefix /usr/local/lib/node_modules/@deepseek-ai/dsh node-pty --build-from-source \
  && test "$(dsh --version)" = "0.1.5-rc.2" \
  && apk del .build-deps

COPY scripts/docker/dsh-trial-entrypoint.sh /usr/local/bin/dsh-trial-entrypoint
RUN chmod 0755 /usr/local/bin/dsh-trial-entrypoint

WORKDIR /workspace
ENTRYPOINT ["dsh-trial-entrypoint"]
